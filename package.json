{
  "name": "pepkio-doubling-time-tracker",
  "version": "0.1.0",
  "description": "Calculate cell or microbial doubling time and growth rate from counts, OD600, or confluency via the Pepkio REST API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-doubling-time-tracker": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_NPM.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-doubling-time-tracker-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-doubling-time-tracker-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/doubling-time-tracker",
  "keywords": [
    "doubling-time-tracker",
    "doubling-time",
    "cell-culture",
    "growth-rate",
    "growth-kinetics",
    "od600",
    "confluency",
    "microbiology",
    "tissue-culture",
    "pepkio",
    "laboratory-tools",
    "life-sciences",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
